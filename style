/* כללי לעמוד */
body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f7f7f7;
    text-align: center;
    color: #333;
}

/* HEADER */
.header {
    background-color: #b19cd9; /* צבע סגול כהה יותר */
    padding: 30px 0;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
}

.logo {
    display: block;
    margin: 0 auto;
    width: 100px; /* לוגו בגודל מתאים */
}

.header h1 {
    margin: 10px 0;
    font-size: 40px;
    color: #333;
    font-weight: bold;
    text-transform: uppercase;
}

.subtitle {
    font-size: 16px;
    color: #444;
    margin-top: -10px;
}

/* תוכן מרכזי */
.container {
    margin: 50px auto;
    padding: 20px;
    max-width: 600px;
    text-align: center;
}

h2 {
    font-size: 36px;
    font-weight: bold;
    color: #333;
    margin-bottom: 20px;
    text-transform: uppercase;
}

p {
    font-size: 18px;
    margin-bottom: 30px;
    color: #555;
}

/* BUTTONS */
button {
    background-color: #ffcc00; /* צבע צהוב מתאים */
    color: #333;
    border: none;
    padding: 15px 30px;
    font-size: 20px;
    margin: 10px;
    cursor: pointer;
    border-radius: 5px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-transform: uppercase;
    font-weight: bold;
}

button:hover {
    background-color: #f39c12;
    transform: scale(1.05); /* אפקט ריחוף */
}

/* IMAGES */
.images {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 20px;
}

.images img {
    width: 180px; /* גודל אחיד */
    height: auto;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}
